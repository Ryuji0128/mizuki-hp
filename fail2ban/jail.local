# fail2ban設定ファイル
# /etc/fail2ban/jail.local にコピーして使用

[DEFAULT]
# ログの読み取り方式
#
# 重要: Ubuntu の /etc/fail2ban/jail.d/defaults-debian.conf は
#   backend = systemd
# を設定しており、これを上書きしないと journald だけを読む。
# nginx は Docker コンテナで journald に書かないため、logpath を指定しても
# 完全に無視され、fail2ban は永久に何も検知しない状態になる。
# （実際に nginx 系 jail が長期間まったく機能していなかった）
#
# ファイルを直接読ませるため polling を明示する。
backend = polling

# デフォルトのBAN時間（24時間）
bantime = 86400
# 監視期間（10分）
findtime = 600
# 最大失敗回数
maxretry = 5
# BAN時の通知先メールアドレス
destemail = info@mizuki-clinic.jp
sender = fail2ban@mizuki-clinic.jp

# アクション: BAN のみ（メール通知なし）
#
# 以前は action_mwl（メール通知付き）だったが、msmtp の認証が失敗すると
# アクションの起動に失敗し、BAN時のたびにエラーを吐き続けていた。
# セキュリティの防御機構がメール送信の可否に依存するのは危険なため、
# 通知は monitor.sh / logwatch 側に任せ、ここは BAN に専念させる。
#
# メール通知を復活させたい場合は、先に必ず疎通確認すること:
#   echo test | msmtp info@setaseisakusyo.com
# その上で以下に変更する:
#   action = %(action_mwl)s
action = %(action_)s

# ----------------------------------
# SSH保護
# ----------------------------------
[sshd]
enabled = true
port = ssh
filter = sshd
# auth.log が rsyslog で出力されている前提。journald のみの環境なら
# この jail だけ backend = systemd に戻すこと。
logpath = /var/log/auth.log
maxretry = 3
bantime = 86400
findtime = 600

# ----------------------------------
# Nginx - 悪意のあるBot対策
# ----------------------------------
[nginx-badbots]
enabled = true
port = http,https
filter = apache-badbots
logpath = /var/log/nginx/access.log
maxretry = 2
bantime = 86400

# ----------------------------------
# Nginx - 404連打ブロック
# ----------------------------------
[nginx-404]
enabled = true
port = http,https
filter = nginx-404
logpath = /var/log/nginx/access.log
maxretry = 10
findtime = 60
bantime = 3600

# ----------------------------------
# Nginx - 認証失敗
# ----------------------------------
[nginx-http-auth]
enabled = true
port = http,https
filter = nginx-http-auth
logpath = /var/log/nginx/error.log
maxretry = 3
bantime = 86400

# ----------------------------------
# Nginx - Proxyスキャン対策
# ----------------------------------
[nginx-proxy]
enabled = true
port = http,https
filter = nginx-proxy
logpath = /var/log/nginx/access.log
maxretry = 2
bantime = 86400

# ----------------------------------
# ブルートフォース対策
# ----------------------------------
[nginx-limit-req]
enabled = true
port = http,https
filter = nginx-limit-req
logpath = /var/log/nginx/error.log
maxretry = 10
findtime = 120
bantime = 7200
